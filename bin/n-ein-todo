#!/usr/bin/env bun
// =============================================================================
// [UI] TODO FUERA DE PI
// La barra de estado de Claude: marca, modelo, rama y la línea compacta del TODO
// de WORK.md (`▸ T9 · 6/10`). El bloque completo lo dibuja el plugin en la franja
// sobre el prompt. Las casillas siguen siendo la fuente de verdad; Claude las
// marca editando el archivo, como Pi.
// =============================================================================

import { fitSegments, STATUS_COLUMNS, todoCompact, type TodoSegment, type TodoTone } from "../pi-package/claude-plugin/hooks/todo-core.ts";
import { branchOf, branchSegments } from "../pi-package/extensions/git-branch.ts";
import { readTodoView, readWorkDoc, resolveWorkDoc } from "../pi-package/extensions/work-doc.ts";

const color = !("NO_COLOR" in process.env);
// Escala de STYLE: acento, primario, gris de cuerpo, apagado y estructura.
const TONE: Record<TodoTone, string> = { accent: "#FFCA40", text: "#FAF3F0", muted: "#9A9A9A", faint: "#5A5A5A", structure: "#3A3A3A" };
const paint = (part: TodoSegment): string => {
  if (!color) return part.text;
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(TONE[part.tone].slice(i, i + 2), 16));
  return `\x1b[38;2;${r};${g};${b}m${part.text}\x1b[39m`;
};
const GAP: TodoSegment = { tone: "text", text: "   " };

function todoParts(cwd: string): TodoSegment[] {
  const path = resolveWorkDoc(cwd);
  if (!path) return [];
  try {
    const view = readTodoView(path);
    return view.tasks.length ? todoCompact(view) : [];
  } catch {
    return [{ tone: "muted", text: "WORK.md ilegible" }];
  }
}

if (process.argv[2] === "--statusline") {
  // Claude pasa el estado de la sesión como JSON por stdin; si falta, vale el cwd.
  let input: { cwd?: string; workspace?: { current_dir?: string }; model?: { display_name?: string } } = {};
  try { input = JSON.parse(await Bun.stdin.text()); } catch { /* sin estado: solo marca */ }
  const cwd = input.workspace?.current_dir ?? input.cwd ?? process.cwd();
  const model = [input.model?.display_name, process.env.N_EIN_CLAUDE_EFFORT].filter(Boolean).join(" · ");
  const branch = await branchOf(cwd);
  const groups: TodoSegment[][] = [
    [{ tone: "text", text: "n" }, { tone: "accent", text: "_" }, { tone: "text", text: "ein" }],
    model ? [{ tone: "muted", text: model }] : [],
    branch ? branchSegments(branch) : [],
    todoParts(cwd),
  ].filter((group) => group.length > 0);
  // GUARD -> nunca más ancha que STATUS_COLUMNS: el pie del plugin reserva justo eso.
  const line = fitSegments(groups.flatMap((group, index) => (index ? [GAP, ...group] : group)), STATUS_COLUMNS);
  console.log(line.map(paint).join(""));
} else {
  const path = resolveWorkDoc(process.cwd());
  if (!path) {
    console.log("Sin WORK.md activo.");
  } else {
    for (const task of readWorkDoc(path).tasks) console.log(`${task.index}. [${task.done ? "x" : " "}] ${task.text}`);
  }
}
