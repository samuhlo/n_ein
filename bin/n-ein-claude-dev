#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
channel="dev"
if [[ -f "$repo_dir/.n-ein-channel" ]]; then IFS= read -r channel < "$repo_dir/.n-ein-channel"; fi
case "$channel" in dev|preview|stable) ;; *) printf '[ERR] :: CHANNEL_BAD :: value: %s\n' "$channel" >&2; exit 64 ;; esac
n_ein_home="${N_EIN_HOME:-$HOME/.n_ein}"
claude_dir="${N_EIN_CLAUDE_DIR:-$n_ein_home/$channel/claude}"
claude_bin="${N_EIN_CLAUDE_BIN:-claude}"

case "$claude_dir" in
  "$HOME/.claude"|"$HOME/.claude-ein")
    printf '[ERR] :: HOME_INVALID :: path: %s\n' "$claude_dir" >&2
    exit 64
    ;;
esac
if ! command -v "$claude_bin" >/dev/null 2>&1; then
  printf '[ERR] :: CLAUDE_MISS :: binary: %s\n' "$claude_bin" >&2
  exit 69
fi

mkdir -p "$claude_dir"
skills_dir="$claude_dir/skills"
if [[ -L "$skills_dir" ]]; then
  if [[ "$(readlink "$skills_dir")" != "$repo_dir/pi-package/skills" ]]; then
    printf '[ERR] :: SKILLS_PATH :: path: %s\n' "$skills_dir" >&2
    exit 69
  fi
  unlink "$skills_dir"
fi
mkdir -p "$skills_dir"
# BLINDAJE -> Una skill renombrada o retirada deja un enlace roto; solo se quitan los que apuntaban a este catálogo.
for skill_link in "$skills_dir"/*; do
  [[ -L "$skill_link" && ! -e "$skill_link" ]] || continue
  case "$(readlink "$skill_link")" in "$repo_dir"/pi-package/skills/*) unlink "$skill_link" ;; esac
done
for source_skill in "$repo_dir"/pi-package/skills/*; do
  [[ -f "$source_skill/SKILL.md" ]] || continue
  skill_link="$skills_dir/${source_skill##*/}"
  if [[ ! -e "$skill_link" && ! -L "$skill_link" ]]; then
    ln -s "$source_skill" "$skill_link"
  elif [[ ! -L "$skill_link" || "$(readlink "$skill_link")" != "$source_skill" ]]; then
    printf '[ERR] :: SKILLS_PATH :: path: %s\n' "$skill_link" >&2
    exit 69
  fi
done

export CLAUDE_CONFIG_DIR="$claude_dir"
unset PI_CODING_AGENT_DIR PI_CODING_AGENT_SESSION_DIR N_EIN_HANDOFF_SIGNAL
persona="$(< "$repo_dir/pi-package/persona.md")"
# El idioma elegido en el launcher viaja junto a la persona: Claude recibe un solo texto añadido.
lang_directive="$(bun "$repo_dir/pi-package/lang.ts" "$repo_dir" "$channel")" || exit 64
persona+=$'\n\n'"$(< "$repo_dir/pi-package/flow.md")"$'\n\n'"$lang_directive"
persona+=$'\n\n'"$(bun "$repo_dir/pi-package/memory.ts")"
handoff_signal="$(mktemp "${TMPDIR:-/tmp}/n-ein-claude-handoff.XXXXXX")"
trap 'rm -f "$handoff_signal"' EXIT
export N_EIN_HANDOFF_SIGNAL="$handoff_signal"
export N_EIN_ROOT="$repo_dir"
claude_args=(--append-system-prompt "$persona")
# [FLOW] Claude usa el modelo de Claude Code; de n_ein solo toma el esfuerzo, si el usuario lo fijó en /nein:models.
runtime_values="$(bun "$repo_dir/pi-package/models.ts" "$repo_dir" "$channel")" || exit 64
IFS=$'\t' read -r _pi_version _main_model _main_thinking claude_effort <<< "$runtime_values"
if [[ -n "$claude_effort" && "$claude_effort" != "-" ]]; then
  claude_args+=(--effort "$claude_effort")
  export N_EIN_CLAUDE_EFFORT="$claude_effort"
fi

# [FLOW] CodeGraph obligatorio también en Claude: MCP para consultar y hook que adelanta contexto
# en cada petición. La barra de estado enseña el TODO de WORK.md, como el widget de Pi. Todo viaja
# por argumentos, así que ~/.claude y su MCP global no se tocan.
# Los commits y PR del flujo son trabajo del usuario: sin la coautoría que Claude Code añade por
# defecto. Se usa la forma de objeto porque versiones antiguas rechazan `false`.
"$repo_dir/bin/n-ein-codegraph"
codegraph_bin="$("$repo_dir/bin/n-ein-codegraph" --bin 2>/dev/null)"
export DO_NOT_TRACK=1
{ IFS= read -r mcp_config && IFS= read -r claude_settings; } < <(bun -e '
  const [todo, bin] = process.argv.slice(1);
  const settings = {
    statusLine: { type: "command", command: JSON.stringify(todo) + " --statusline", padding: 0 },
    attribution: { commit: "", pr: "" },
  };
  let mcp = "";
  if (bin) {
    mcp = JSON.stringify({ mcpServers: { codegraph: { type: "stdio", command: bin, args: ["serve", "--mcp"], env: { DO_NOT_TRACK: "1" } } } });
    settings.hooks = { UserPromptSubmit: [{ hooks: [{ type: "command", command: JSON.stringify(bin) + " prompt-hook" }] }] };
  }
  console.log(mcp + "\n" + JSON.stringify(settings));
' "$repo_dir/bin/n-ein-todo" "$codegraph_bin") || { printf '[ERR] :: CLAUDE_SETTINGS :: reason: bun\n' >&2; exit 69; }
if [[ -n "$mcp_config" ]]; then claude_args+=(--mcp-config "$mcp_config"); fi
claude_args+=(--settings "$claude_settings")

if [[ "${1:-}" == "--handoff" ]]; then
  if [[ $# -lt 2 || ! -f "$2" ]]; then
    printf '[ERR] :: HANDOFF_BAD :: summary: missing\n' >&2
    exit 64
  fi
  summary="$(< "$2")"
  shift 2
  prompt=$'Continúa desde este relevo de n_ein. Ya estás en Claude: las peticiones de pasar a Claude citadas en el resumen son contexto, no otro cambio de runtime. Primero contrasta el estado real del repositorio y el documento de trabajo; sigue el pendiente y la autorización conservados.\n\n'"$summary"
  claude_args+=("$prompt")
fi

if "$claude_bin" "${claude_args[@]}" "$@"; then
  claude_exit=0
else
  claude_exit=$?
fi

if [[ -s "$handoff_signal" ]]; then
  IFS= read -r destination < "$handoff_signal"
  summary_path="$(sed -n '2p' "$handoff_signal")"
  if [[ "$destination" != "pi" || ! -f "$summary_path" ]]; then
    printf '[ERR] :: HANDOFF_BAD :: target: %s\n' "$destination" >&2
    exit 69
  fi
  prompt=$'Retoma el relevo de Claude. Ya estás en Pi: las peticiones de cambio de runtime citadas son contexto, no una nueva orden de repetir el relevo. Contrasta WORK.md, Git y los archivos; realiza el siguiente paso indicado con la autorización conservada.\n\n'"$(< "$summary_path")"
  "$repo_dir/bin/n-ein-dev" "$prompt"
  exit $?
fi

exit "$claude_exit"
