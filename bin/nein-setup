#!/usr/bin/env bash
set -euo pipefail

# [FLOW] INSTALACIÓN AGRUPADA
# Envoltorio del paquete: n-ein-install setup instala Pi, código y entrada PATH; no copia autenticación.
package_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
installer="$package_root/bin/n-ein-install"
if [[ ! -x "$installer" || ! -f "$package_root/package-manifest.json" ]]; then
  printf '[ERR] :: PACKAGE_BAD :: nein-setup requiere un candidato empaquetado\n' >&2
  exit 64
fi
# BLINDAJE -> El doctor final debe comprobar el Pi gestionado, no uno heredado del entorno.
unset N_EIN_PI_BIN
exec "$installer" setup --source "$package_root" "$@"
