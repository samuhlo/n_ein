#!/usr/bin/env bash
set -euo pipefail

# El relevo vuelve al proyecto del coordinador aunque una herramienta cambie de cwd.
export N_EIN_COORDINATOR_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"

# [FLOW] ARRANQUE AISLADO
# Pi conserva su configuración, autenticación y sesiones dentro de este hogar.
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
channel="dev"
if [[ -f "$repo_dir/.n-ein-channel" ]]; then IFS= read -r channel < "$repo_dir/.n-ein-channel"; fi
case "$channel" in dev|preview|stable) ;; *) printf '[ERR] :: CHANNEL_BAD :: value: %s\n' "$channel" >&2; exit 64 ;; esac
export N_EIN_CHANNEL="$channel"
if ! command -v bun >/dev/null 2>&1; then
  printf '[ERR] :: BUN_MISSING :: required: runtime.json\n' >&2
  exit 69
fi
runtime_values="$(bun "$repo_dir/pi-package/models.ts" "$repo_dir" "$channel")" || exit 64
IFS=$'\t' read -r expected_pi_version main_model main_thinking _claude_effort <<< "$runtime_values"
lang_directive="$(bun "$repo_dir/pi-package/lang.ts" "$repo_dir" "$channel")" || exit 64
memory_directive="$(bun "$repo_dir/pi-package/memory.ts")"
flow_args=(--append-system-prompt "$repo_dir/pi-package/pi-only.md" --append-system-prompt "$repo_dir/pi-package/flow.md")
if [[ "${N_EIN_TEAM:-0}" == 1 ]]; then
  flow_args+=(--append-system-prompt "$repo_dir/pi-package/agents/team.md")
fi
n_ein_home="${N_EIN_HOME:-$HOME/.n_ein}"
agent_dir="${N_EIN_AGENT_DIR:-$n_ein_home/$channel/pi-agent}"
pi_bin="${N_EIN_PI_BIN:-$n_ein_home/runtimes/pi/$expected_pi_version/bin/pi}"

case "$agent_dir" in
  "$HOME/.pi/agent"|"$HOME/.pi-ein"|"$HOME/.pi-ein/agent")
    printf '[ERR] :: HOME_INVALID :: path: %s\n' "$agent_dir" >&2
    exit 64
    ;;
esac

if ! command -v "$pi_bin" >/dev/null 2>&1; then
  printf '[ERR] :: PI_MISSING :: binary: %s | fix: n-ein-install runtime --source %s\n' "$pi_bin" "$repo_dir" >&2
  exit 69
fi

pi_version="$("$pi_bin" --version)"
if [[ "$pi_version" != "$expected_pi_version" ]]; then
  printf '[ERR] :: PI_VERSION :: expected: %s | actual: %s\n' "$expected_pi_version" "$pi_version" >&2
  exit 69
fi

# BLINDAJE -> El índice se prepara una vez por sesión, antes de que el agente lo consulte.
"$repo_dir/bin/n-ein-codegraph"
N_EIN_CODEGRAPH_BIN="$("$repo_dir/bin/n-ein-codegraph" --bin 2>/dev/null)"
if [[ -n "$N_EIN_CODEGRAPH_BIN" ]]; then export N_EIN_CODEGRAPH_BIN; else unset N_EIN_CODEGRAPH_BIN; fi
export DO_NOT_TRACK=1
# n_ein fija la versión de Pi y la actualiza con su propio instalador: el aviso de `pi update` confundiría.
export PI_SKIP_VERSION_CHECK=1
export PI_CODING_AGENT_DIR="$agent_dir"
# BLINDAJE -> El banner de n_ein sustituye al listado de arranque de Pi; si el usuario fijó quietStartup, se respeta.
{
  bun -e '
    const path = process.argv[1];
    const file = Bun.file(path);
    const settings = (await file.exists()) ? await file.json() : {};
    if (!("quietStartup" in settings)) await Bun.write(path, JSON.stringify({ ...settings, quietStartup: true }, null, 2) + "\n");
  ' "$agent_dir/settings.json" 2>/dev/null || printf '[WARN] :: SETTINGS_SKIP :: path: %s\n' "$agent_dir/settings.json" >&2
}
export PI_CODING_AGENT_SESSION_DIR="$agent_dir/sessions"
handoff_signal="$(mktemp "${TMPDIR:-/tmp}/n-ein-handoff.XXXXXX")"
trap 'rm -f "$handoff_signal"' EXIT
export N_EIN_HANDOFF_SIGNAL="$handoff_signal"

# BLINDAJE -> Solo los recursos explícitos del paquete entran desde fuera del proyecto.
if "$pi_bin" \
  --no-extensions --no-skills --no-prompt-templates --no-themes \
  -e "$repo_dir/pi-package" \
  --append-system-prompt "$repo_dir/pi-package/persona.md" \
  ${flow_args[@]+"${flow_args[@]}"} \
  --append-system-prompt "$lang_directive" \
  --append-system-prompt "$memory_directive" \
  --use-theme ein \
  --model "$main_model" --thinking "$main_thinking" \
  "$@"; then
  pi_exit=0
else
  pi_exit=$?
fi

if [[ -s "$handoff_signal" ]]; then
  IFS= read -r destination < "$handoff_signal"
  summary_path="$(sed -n '2p' "$handoff_signal")"
  if [[ "$destination" != "claude" || ! -f "$summary_path" ]]; then
    printf '[ERR] :: HANDOFF_BAD :: target: %s\n' "$destination" >&2
    exit 69
  fi
  "$repo_dir/bin/n-ein-claude-dev" --handoff "$summary_path"
  exit $?
fi

exit "$pi_exit"
