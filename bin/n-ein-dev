#!/usr/bin/env bash
set -euo pipefail

# [FLOW] ARRANQUE AISLADO
# Pi conserva su configuración, autenticación y sesiones dentro de este hogar.
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
agent_dir="${N_EIN_AGENT_DIR:-$HOME/.n_ein/dev/pi-agent}"
pi_bin="${N_EIN_PI_BIN:-pi}"

case "$agent_dir" in
  "$HOME/.pi/agent"|"$HOME/.pi-ein"|"$HOME/.pi-ein/agent")
    printf '[ERR] :: HOME_INVALID :: path: %s\n' "$agent_dir" >&2
    exit 64
    ;;
esac

if ! command -v "$pi_bin" >/dev/null 2>&1; then
  printf '[ERR] :: PI_MISSING :: binary: %s\n' "$pi_bin" >&2
  exit 69
fi

pi_version="$("$pi_bin" --version)"
if [[ "$pi_version" != "0.87.1" ]]; then
  printf '[ERR] :: PI_VERSION :: expected: 0.87.1 | actual: %s\n' "$pi_version" >&2
  exit 69
fi

export PI_CODING_AGENT_DIR="$agent_dir"
export PI_CODING_AGENT_SESSION_DIR="$agent_dir/sessions"
handoff_signal="$(mktemp "${TMPDIR:-/tmp}/n-ein-handoff.XXXXXX")"
trap 'rm -f "$handoff_signal"' EXIT
export N_EIN_HANDOFF_SIGNAL="$handoff_signal"

# BLINDAJE -> Solo los recursos explícitos del paquete entran desde fuera del proyecto.
if "$pi_bin" \
  --no-extensions --no-skills --no-prompt-templates --no-themes \
  -e "$repo_dir/pi-package" \
  --append-system-prompt "$repo_dir/pi-package/persona.md" \
  --append-system-prompt "$repo_dir/pi-package/pi-only.md" \
  --use-theme ein \
  --model openai-codex/gpt-6-sol --thinking high \
  "$@"; then
  pi_exit=0
else
  pi_exit=$?
fi

if [[ -s "$handoff_signal" ]]; then
  IFS= read -r destination < "$handoff_signal"
  summary_path="$(sed -n '2p' "$handoff_signal")"
  if [[ "$destination" != "claude" || ! -f "$summary_path" ]]; then
    printf '[ERR] :: HANDOFF_BAD :: target: %s\n' "$destination" >&2
    exit 69
  fi
  "$repo_dir/bin/n-ein-claude-dev" --handoff "$summary_path"
  exit $?
fi

exit "$pi_exit"
