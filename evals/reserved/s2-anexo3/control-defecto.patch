diff --git a/tests/server/export/planificacion-anexo3.test.ts b/tests/server/export/planificacion-anexo3.test.ts
new file mode 100644
index 0000000..b8034a8
--- /dev/null
+++ b/tests/server/export/planificacion-anexo3.test.ts
@@ -0,0 +1,42 @@
+/**
+ * Anexo III — origen de la planificación que se exporta.
+ * Con curso resuelto manda lo guardado en el servidor; sin curso (asistente,
+ * D7) no hay nada guardado y se usa el cuerpo.
+ */
+
+import { describe, it, expect, vi } from 'vitest'
+
+;(globalThis as Record<string, unknown>).createError = vi.fn((opts: { statusCode: number; message: string }) => {
+  const err = new Error(opts.message) as Error & { statusCode: number }
+  err.statusCode = opts.statusCode
+  return err
+})
+
+const { planificacionAnexo3 } = await import('../../../server/utils/export/planificacion-anexo3')
+
+const CUERPO = { certificado: { codigo: 'MANIPULADO', nombre: 'Del cliente' }, modulos: [{ code: 'X' }] }
+const GUARDADA = { certificado: { codigo: 'IFCD0110', nombre: 'DAW' }, modulos: [{ code: 'MF0950_2' }] }
+
+function contextoCon(config: Record<string, unknown>) {
+  return { curso: { config } } as unknown as Parameters<typeof planificacionAnexo3>[0]
+}
+
+describe('planificacionAnexo3', () => {
+  it('con curso → devuelve la planificación guardada e ignora el cuerpo', () => {
+    const plan = planificacionAnexo3(contextoCon({ planningSnapshot: { resultado: GUARDADA } }), CUERPO)
+    expect(plan).toEqual(GUARDADA)
+  })
+
+  it('sin curso → devuelve el cuerpo', () => {
+    expect(planificacionAnexo3(null, CUERPO)).toEqual(CUERPO)
+  })
+
+  it('curso sin planificación guardada → 409, nunca cae al cuerpo', () => {
+    expect(() => planificacionAnexo3(contextoCon({}), CUERPO)).toThrow(expect.objectContaining({ statusCode: 409 }))
+  })
+
+  it('planificación guardada sin certificado.codigo → 409', () => {
+    const config = { planningSnapshot: { resultado: { certificado: { nombre: 'DAW' } } } }
+    expect(() => planificacionAnexo3(contextoCon(config), CUERPO)).toThrow(expect.objectContaining({ statusCode: 409 }))
+  })
+})
