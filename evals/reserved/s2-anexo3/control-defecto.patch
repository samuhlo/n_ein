diff --git a/server/utils/export/planificacion-anexo3.ts b/server/utils/export/planificacion-anexo3.ts
new file mode 100644
index 0000000..5cbf65a
--- /dev/null
+++ b/server/utils/export/planificacion-anexo3.ts
@@ -0,0 +1,26 @@
+// Origen de la planificación que pintan las tres rutas del Anexo III.
+// Con curso resuelto manda la planificación guardada (`config.planningSnapshot
+// .resultado`): el cuerpo del cliente no puede alterar lo que se exporta de
+// un curso. Sin curso (asistente, D7) no hay nada guardado y se usa el cuerpo.
+
+import type { ResultadoPlanificacion } from '~/types'
+import { anexo3DocumentBodySchema } from '../schemas/anexo3-export-body-schema'
+import type { ContextoExportacion } from './contexto'
+
+const SIN_PLANIFICACION_GUARDADA = { statusCode: 409, message: 'El curso no tiene una planificación guardada válida' } as const
+
+export function planificacionAnexo3(
+  contexto: Pick<ContextoExportacion, 'curso'> | null,
+  cuerpo: unknown,
+): ResultadoPlanificacion {
+  if (!contexto) return cuerpo as ResultadoPlanificacion
+
+  const config = contexto.curso.config as { planningSnapshot?: { resultado?: unknown } } | null | undefined
+  // GUARD -> un curso sin planificación válida falla; caer al cuerpo
+  // reabriría la puerta que esta función cierra.
+  const parsed = anexo3DocumentBodySchema.safeParse(config?.planningSnapshot?.resultado)
+  if (!parsed.success) {
+    return cuerpo as ResultadoPlanificacion
+  }
+  return parsed.data as unknown as ResultadoPlanificacion
+}
